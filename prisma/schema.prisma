datasource db {
  provider = "postgresql"
  url      = "postgresql://dummy:dummy@localhost:5432/postgres"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CENTRAL_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  BILLING
  PATIENT
}

enum HospitalStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

enum QueueEventStatus {
  WAITING
  CALLED
  IN_ROOM
  COMPLETED
  MISSED
}

enum BillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  CASH
  INSURANCE_DIRECT
}

enum Shift {
  MORNING
  EVENING
  NIGHT
}

model Hospital {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  name               String
  city               String
  address            String
  phone              String
  email              String
  status             String   @default("ACTIVE")
  emergencyAvailable Boolean  @default(true) @map("emergency_available")
  totalBeds          Int      @default(100) @map("total_beds")
  availableBeds      Int      @default(24) @map("available_beds")
  rating             String   @default("4.8")
  description        String?
  createdAt          DateTime @default(now()) @map("created_at")

  users               User[]
  departments         Department[]
  doctorProfiles      DoctorProfile[]
  nurseProfiles       NurseProfile[]
  receptionistProfiles ReceptionistProfile[]
  billingProfiles     BillingProfile[]
  appointments        Appointment[]
  appointmentSlots    AppointmentSlot[]
  queues              Queue[]
  bills               Bill[]
  payments            Payment[]
  refunds             Refund[]
  hospitalInsurances  HospitalInsurance[]
  notifications       Notification[]
  messages            Message[]
  hospitalUpdates     HospitalUpdate[]
  reviews             Review[]
  staffAssignments    StaffAssignment[]
  auditLogs           AuditLog[]
  hospitalExpenses    HospitalExpense[]
  consultations       Consultation[]
  medicalRecords      MedicalRecord[]
  vitals              Vital[]
  prescriptions       Prescription[]

  @@map("hospitals")
}

model User {
  id                 Int      @id @default(autoincrement())
  uid                String   @unique
  username           String   @unique
  email              String   @unique
  passwordHash       String   @map("password_hash")
  role               String
  hospitalId         Int?     @map("hospital_id")
  fullName           String   @map("full_name")
  phone              String?
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  isEmailVerified    Boolean  @default(false) @map("is_email_verified")
  otpSecret          String?  @map("otp_secret")
  otpExpiresAt       DateTime? @map("otp_expires_at")
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  hospital            Hospital?            @relation(fields: [hospitalId], references: [id])
  doctorProfile       DoctorProfile?
  nurseProfile        NurseProfile?
  receptionistProfile ReceptionistProfile?
  billingProfile      BillingProfile?
  patientProfile      PatientProfile?
  notifications       Notification[]
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  staffAssignments    StaffAssignment[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Department {
  id             Int      @id @default(autoincrement())
  hospitalId     Int      @map("hospital_id")
  name           String
  description    String?
  headDoctorName String?  @map("head_doctor_name")
  createdAt      DateTime @default(now()) @map("created_at")

  hospital         Hospital          @relation(fields: [hospitalId], references: [id])
  doctorProfiles   DoctorProfile[]
  nurseProfiles    NurseProfile[]
  appointments     Appointment[]
  queues           Queue[]
  staffAssignments StaffAssignment[]

  @@map("departments")
}

model DoctorProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  hospitalId      Int      @map("hospital_id")
  departmentId    Int      @map("department_id")
  specialty       String
  qualification   String
  experienceYears Int      @default(5) @map("experience_years")
  consultationFee Int      @default(50) @map("consultation_fee")
  roomNumber      String?  @map("room_number")
  bio             String?
  isAvailable     Boolean  @default(true) @map("is_available")

  user                 User                 @relation(fields: [userId], references: [id])
  hospital             Hospital             @relation(fields: [hospitalId], references: [id])
  department           Department           @relation(fields: [departmentId], references: [id])
  appointmentSlots     AppointmentSlot[]
  appointments         Appointment[]
  consultations        Consultation[]
  doctorAvailabilities DoctorAvailability[]
  reviews              Review[]
  queues               Queue[]
  medicalRecords       MedicalRecord[]
  prescriptions        Prescription[]

  @@map("doctor_profiles")
}

model NurseProfile {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique @map("user_id")
  hospitalId   Int     @map("hospital_id")
  departmentId Int?    @map("department_id")
  shift        String  @default("MORNING")
  station      String?

  user       User        @relation(fields: [userId], references: [id])
  hospital   Hospital    @relation(fields: [hospitalId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  vitals     Vital[]

  @@map("nurse_profiles")
}

model ReceptionistProfile {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique @map("user_id")
  hospitalId Int     @map("hospital_id")
  deskNumber String? @map("desk_number")

  user     User     @relation(fields: [userId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@map("receptionist_profiles")
}

model BillingProfile {
  id            Int     @id @default(autoincrement())
  userId        Int     @unique @map("user_id")
  hospitalId    Int     @map("hospital_id")
  counterNumber String? @map("counter_number")

  user     User     @relation(fields: [userId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@map("billing_profiles")
}

model PatientProfile {
  id               Int     @id @default(autoincrement())
  userId           Int     @unique @map("user_id")
  dob              String?
  gender           String?
  address          String?
  bloodGroup       String? @map("blood_group")
  emergencyContact String? @map("emergency_contact")
  allergies        String?

  user              User               @relation(fields: [userId], references: [id])
  appointments      Appointment[]
  queueEvents       QueueEvent[]
  consultations     Consultation[]
  medicalRecords    MedicalRecord[]
  vitals            Vital[]
  prescriptions     Prescription[]
  bills             Bill[]
  payments          Payment[]
  patientInsurances PatientInsurance[]
  reviews           Review[]

  @@map("patient_profiles")
}

model AppointmentSlot {
  id          Int    @id @default(autoincrement())
  hospitalId  Int    @map("hospital_id")
  doctorId    Int    @map("doctor_id")
  date        String
  startTime   String @map("start_time")
  endTime     String @map("end_time")
  maxPatients Int    @default(1) @map("max_patients")
  bookedCount Int    @default(0) @map("booked_count")
  status      String @default("AVAILABLE")

  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id])
  appointments Appointment[]

  @@map("appointment_slots")
}

model Appointment {
  id               Int      @id @default(autoincrement())
  bookingReference String   @unique @map("booking_reference")
  hospitalId       Int      @map("hospital_id")
  patientId        Int      @map("patient_id")
  doctorId         Int      @map("doctor_id")
  departmentId     Int      @map("department_id")
  slotId           Int?     @map("slot_id")
  appointmentDate  String   @map("appointment_date")
  appointmentTime  String   @map("appointment_time")
  reason           String?
  status           String   @default("CONFIRMED")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  hospital      Hospital         @relation(fields: [hospitalId], references: [id])
  patient       PatientProfile   @relation(fields: [patientId], references: [id])
  doctor        DoctorProfile    @relation(fields: [doctorId], references: [id])
  department    Department       @relation(fields: [departmentId], references: [id])
  slot          AppointmentSlot? @relation(fields: [slotId], references: [id])
  queueEvents   QueueEvent[]
  consultations Consultation[]
  bills         Bill[]

  @@map("appointments")
}

model Queue {
  id                  Int    @id @default(autoincrement())
  hospitalId          Int    @map("hospital_id")
  departmentId        Int    @map("department_id")
  doctorId            Int?   @map("doctor_id")
  date                String
  currentCallingToken Int    @default(0) @map("current_calling_token")
  totalTokens         Int    @default(0) @map("total_tokens")
  status              String @default("ACTIVE")

  hospital    Hospital       @relation(fields: [hospitalId], references: [id])
  department  Department     @relation(fields: [departmentId], references: [id])
  doctor      DoctorProfile? @relation(fields: [doctorId], references: [id])
  queueEvents QueueEvent[]

  @@map("queues")
}

model QueueEvent {
  id                   Int       @id @default(autoincrement())
  queueId              Int       @map("queue_id")
  appointmentId        Int?      @map("appointment_id")
  patientId            Int       @map("patient_id")
  tokenNumber          Int       @map("token_number")
  status               String    @default("WAITING")
  estimatedWaitMinutes Int       @default(15) @map("estimated_wait_minutes")
  calledAt             DateTime? @map("called_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  queue       Queue          @relation(fields: [queueId], references: [id])
  appointment Appointment?   @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile @relation(fields: [patientId], references: [id])

  @@map("queue_events")
}

model Consultation {
  id             Int      @id @default(autoincrement())
  appointmentId  Int      @map("appointment_id")
  hospitalId     Int      @map("hospital_id")
  doctorId       Int      @map("doctor_id")
  patientId      Int      @map("patient_id")
  chiefComplaint String?  @map("chief_complaint")
  diagnosis      String?
  clinicalNotes  String?  @map("clinical_notes")
  followUpDate   String?  @map("follow_up_date")
  createdAt      DateTime @default(now()) @map("created_at")

  appointment   Appointment    @relation(fields: [appointmentId], references: [id])
  hospital      Hospital       @relation(fields: [hospitalId], references: [id])
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id])
  patient       PatientProfile @relation(fields: [patientId], references: [id])
  prescriptions Prescription[]

  @@map("consultations")
}

model MedicalRecord {
  id         Int      @id @default(autoincrement())
  hospitalId Int      @map("hospital_id")
  patientId  Int      @map("patient_id")
  doctorId   Int?     @map("doctor_id")
  recordType String   @map("record_type")
  title      String
  details    String?
  fileUrl    String?  @map("file_url")
  recordedAt DateTime @default(now()) @map("recorded_at")

  hospital Hospital       @relation(fields: [hospitalId], references: [id])
  patient  PatientProfile @relation(fields: [patientId], references: [id])
  doctor   DoctorProfile? @relation(fields: [doctorId], references: [id])

  @@map("medical_records")
}

model Vital {
  id                Int      @id @default(autoincrement())
  hospitalId        Int      @map("hospital_id")
  patientId         Int      @map("patient_id")
  recordedByNurseId Int?     @map("recorded_by_nurse_id")
  bloodPressure     String?  @map("blood_pressure")
  heartRate         Int?     @map("heart_rate")
  temperature       String?
  respiratoryRate   Int?     @map("respiratory_rate")
  oxygenSaturation  Int?     @map("oxygen_saturation")
  weightKg          String?  @map("weight_kg")
  recordedAt        DateTime @default(now()) @map("recorded_at")

  hospital Hospital       @relation(fields: [hospitalId], references: [id])
  patient  PatientProfile @relation(fields: [patientId], references: [id])
  nurse    NurseProfile?  @relation(fields: [recordedByNurseId], references: [id])

  @@map("vitals")
}

model Prescription {
  id             Int      @id @default(autoincrement())
  consultationId Int      @map("consultation_id")
  hospitalId     Int      @map("hospital_id")
  patientId      Int      @map("patient_id")
  doctorId       Int      @map("doctor_id")
  medicationName String   @map("medication_name")
  dosage         String
  frequency      String
  durationDays   Int      @map("duration_days")
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation   @relation(fields: [consultationId], references: [id])
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  patient      PatientProfile @relation(fields: [patientId], references: [id])
  doctor       DoctorProfile  @relation(fields: [doctorId], references: [id])

  @@map("prescriptions")
}

model Bill {
  id                Int      @id @default(autoincrement())
  billNumber        String   @unique @map("bill_number")
  hospitalId        Int      @map("hospital_id")
  patientId         Int      @map("patient_id")
  appointmentId     Int?     @map("appointment_id")
  totalAmount       Int      @map("total_amount")
  insuranceDiscount Int      @default(0) @map("insurance_discount")
  netPayable        Int      @map("net_payable")
  paidAmount        Int      @default(0) @map("paid_amount")
  status            String   @default("PENDING")
  dueDate           String?  @map("due_date")
  createdAt         DateTime @default(now()) @map("created_at")

  hospital    Hospital       @relation(fields: [hospitalId], references: [id])
  patient     PatientProfile @relation(fields: [patientId], references: [id])
  appointment Appointment?   @relation(fields: [appointmentId], references: [id])
  billItems   BillItem[]
  payments    Payment[]
  refunds     Refund[]

  @@map("bills")
}

model BillItem {
  id          Int    @id @default(autoincrement())
  billId      Int    @map("bill_id")
  description String
  unitPrice   Int    @map("unit_price")
  quantity    Int    @default(1)
  totalPrice  Int    @map("total_price")

  bill Bill @relation(fields: [billId], references: [id])

  @@map("bill_items")
}

model Payment {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique @map("transaction_id")
  billId        Int      @map("bill_id")
  hospitalId    Int      @map("hospital_id")
  patientId     Int      @map("patient_id")
  amount        Int
  paymentMethod String   @map("payment_method")
  status        String   @default("SUCCESS")
  paidAt        DateTime @default(now()) @map("paid_at")

  bill     Bill           @relation(fields: [billId], references: [id])
  hospital Hospital       @relation(fields: [hospitalId], references: [id])
  patient  PatientProfile @relation(fields: [patientId], references: [id])
  refunds  Refund[]

  @@map("payments")
}

model Refund {
  id           Int      @id @default(autoincrement())
  refundNumber String   @unique @map("refund_number")
  paymentId    Int      @map("payment_id")
  billId       Int      @map("bill_id")
  hospitalId   Int      @map("hospital_id")
  amount       Int
  reason       String
  status       String   @default("COMPLETED")
  processedAt  DateTime @default(now()) @map("processed_at")

  payment  Payment  @relation(fields: [paymentId], references: [id])
  bill     Bill     @relation(fields: [billId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@map("refunds")
}

model InsuranceProvider {
  id             Int      @id @default(autoincrement())
  name           String
  code           String   @unique
  coverageType   String   @map("coverage_type")
  supportContact String?  @map("support_contact")
  isActive       Boolean  @default(true) @map("is_active")

  hospitalInsurances HospitalInsurance[]
  patientInsurances  PatientInsurance[]

  @@map("insurance_providers")
}

model HospitalInsurance {
  id                  Int     @id @default(autoincrement())
  hospitalId          Int     @map("hospital_id")
  providerId          Int     @map("provider_id")
  isCashlessSupported Boolean @default(true) @map("is_cashless_supported")
  copayPercentage     Int     @default(10) @map("copay_percentage")

  hospital Hospital          @relation(fields: [hospitalId], references: [id])
  provider InsuranceProvider @relation(fields: [providerId], references: [id])

  @@map("hospital_insurances")
}

model PatientInsurance {
  id             Int    @id @default(autoincrement())
  patientId      Int    @map("patient_id")
  providerId     Int    @map("provider_id")
  policyNumber   String @map("policy_number")
  validUntil     String @map("valid_until")
  coverageAmount Int    @map("coverage_amount")
  status         String @default("VERIFIED")

  patient  PatientProfile    @relation(fields: [patientId], references: [id])
  provider InsuranceProvider @relation(fields: [providerId], references: [id])

  @@map("patient_insurances")
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  hospitalId Int?     @map("hospital_id")
  title      String
  message    String
  type       String   @default("INFO")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  hospital Hospital? @relation(fields: [hospitalId], references: [id])

  @@map("notifications")
}

model Message {
  id              Int      @id @default(autoincrement())
  hospitalId      Int      @map("hospital_id")
  senderUserId    Int      @map("sender_user_id")
  recipientUserId Int?     @map("recipient_user_id")
  subject         String
  content         String
  sentAt          DateTime @default(now()) @map("sent_at")

  hospital  Hospital @relation(fields: [hospitalId], references: [id])
  sender    User     @relation("SentMessages", fields: [senderUserId], references: [id])
  recipient User?    @relation("ReceivedMessages", fields: [recipientUserId], references: [id])

  @@map("messages")
}

model HospitalUpdate {
  id         Int      @id @default(autoincrement())
  hospitalId Int      @map("hospital_id")
  title      String
  content    String
  category   String   @default("ANNOUNCEMENT")
  isPublic   Boolean  @default(true) @map("is_public")
  createdAt  DateTime @default(now()) @map("created_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@map("hospital_updates")
}

model Review {
  id         Int      @id @default(autoincrement())
  hospitalId Int      @map("hospital_id")
  patientId  Int      @map("patient_id")
  doctorId   Int?     @map("doctor_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  hospital Hospital       @relation(fields: [hospitalId], references: [id])
  patient  PatientProfile @relation(fields: [patientId], references: [id])
  doctor   DoctorProfile? @relation(fields: [doctorId], references: [id])

  @@map("reviews")
}

model DoctorAvailability {
  id          Int     @id @default(autoincrement())
  doctorId    Int     @map("doctor_id")
  dayOfWeek   Int     @map("day_of_week")
  startTime   String  @map("start_time")
  endTime     String  @map("end_time")
  isAvailable Boolean @default(true) @map("is_available")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@map("doctor_availabilities")
}

model StaffAssignment {
  id            Int     @id @default(autoincrement())
  hospitalId    Int     @map("hospital_id")
  userId        Int     @map("user_id")
  departmentId  Int?    @map("department_id")
  shiftName     String? @map("shift_name")
  effectiveFrom String? @map("effective_from")
  status        String  @default("ACTIVE")

  hospital   Hospital    @relation(fields: [hospitalId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@map("staff_assignments")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  hospitalId Int?     @map("hospital_id")
  userId     Int?     @map("user_id")
  action     String
  resource   String
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  hospital Hospital? @relation(fields: [hospitalId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model PlatformExpense {
  id           Int      @id @default(autoincrement())
  category     String
  description  String
  amount       Int
  recordedDate String   @map("recorded_date")
  recordedBy   String?  @map("recorded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("platform_expenses")
}

model HospitalExpense {
  id          Int      @id @default(autoincrement())
  hospitalId  Int      @map("hospital_id")
  category    String
  description String
  amount      Int
  expenseDate String   @map("expense_date")
  createdAt   DateTime @default(now()) @map("created_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@map("hospital_expenses")
}
